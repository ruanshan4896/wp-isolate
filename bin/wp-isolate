#!/usr/bin/env bash
# bin/wp-isolate - aaPanel OpenLiteSpeed Website Isolation Utility
set -eu
set -o pipefail 2>/dev/null || true

# Resolve real path of the script even when executed via symlink
TARGET_SCRIPT="${BASH_SOURCE[0]}"
if [ -h "$TARGET_SCRIPT" ] || command -v readlink >/dev/null 2>&1; then
    TARGET_SCRIPT="$(readlink -f "$TARGET_SCRIPT" 2>/dev/null || realpath "$TARGET_SCRIPT" 2>/dev/null || echo "$TARGET_SCRIPT")"
fi
SCRIPT_DIR="$(cd "$(dirname "$TARGET_SCRIPT")/.." && pwd)"

# Fallback to standard installation directory if lib is not in SCRIPT_DIR
if [ ! -d "${SCRIPT_DIR}/lib" ] && [ -d "/opt/wp-isolate/lib" ]; then
    SCRIPT_DIR="/opt/wp-isolate"
fi

# Source libraries
source "${SCRIPT_DIR}/lib/common.sh"
source "${SCRIPT_DIR}/lib/os_user.sh"
source "${SCRIPT_DIR}/lib/ols_vhost.sh"
source "${SCRIPT_DIR}/lib/mysql_limit.sh"
source "${SCRIPT_DIR}/lib/redis_isolate.sh"

# Paths
BASE_DIR="${WP_ISOLATE_DIR:-/opt/wp-isolate}"
VHOSTS_DIR="${BASE_DIR}/vhosts"
BACKUPS_DIR="${BASE_DIR}/backups"
DATA_DIR="${BASE_DIR}/data"
SITES_REGISTRY="${DATA_DIR}/sites.json"

init_storage() {
    mkdir -p "$VHOSTS_DIR" "$BACKUPS_DIR" "$DATA_DIR"
    if [ ! -f "$SITES_REGISTRY" ]; then
        echo "{}" > "$SITES_REGISTRY"
    fi
}

update_site_registry() {
    local domain="$1"
    local user="$2"
    local redis_db="$3"
    local reg="${SITES_REGISTRY:-/opt/wp-isolate/data/sites.json}"
    mkdir -p "$(dirname "$reg")"
    if [ ! -f "$reg" ]; then echo "{}" > "$reg"; fi
    
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "
import json, sys
reg_file, domain, user, r_db = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
try:
    with open(reg_file, 'r') as f:
        data = json.load(f)
except Exception:
    data = {}
data[domain] = {'user': user, 'redis_db': int(r_db) if r_db.isdigit() else r_db}
with open(reg_file, 'w') as f:
    json.dump(data, f, indent=2)
" "$reg" "$domain" "$user" "$redis_db" 2>/dev/null || true
    fi
}

remove_from_registry() {
    local domain="$1"
    local reg="${SITES_REGISTRY:-/opt/wp-isolate/data/sites.json}"
    if [ -f "$reg" ] && command -v python3 >/dev/null 2>&1; then
        python3 -c "
import json, sys
reg_file, domain = sys.argv[1], sys.argv[2]
try:
    with open(reg_file, 'r') as f:
        data = json.load(f)
    if domain in data:
        del data[domain]
    with open(reg_file, 'w') as f:
        json.dump(data, f, indent=2)
except Exception:
    pass
" "$reg" "$domain" 2>/dev/null || true
    fi
}

cmd_help() {
    cat << 'EOF'
Usage: wp-isolate <command> [arguments] [options]

Core Commands:
  list                          List all websites and their isolation status
  isolate <domain> [options]    Isolate a website with dedicated suEXEC user and limits
  isolate-all [options]         Isolate all websites (use --force to re-apply to all)
  restore <domain>              Revert website back to default aaPanel (www:www)
  status <domain>               Display detailed isolation status and metrics
  verify                        Audit system integrity and check for configuration drift
  repair [domain]               Re-apply isolated configuration hooks

Options for 'isolate':
  --max-conns <num>             Max concurrent PHP workers (Default: 15)
  --mem-limit <size>            Max memory limit e.g. 512M (Default: 512M)
  --db-limit <num>              Max MySQL connections for site DB user (Default: 25)
  --req-limit <num>             Max dynamic requests/sec per client IP (Default: 10)
  --redis-db <num>              Custom Redis Database ID (Default: auto-allocated 1..63)
  --no-redis                    Skip Redis cache isolation configuration
  --docroot <path>              Override website document root path

Examples:
  wp-isolate list
  wp-isolate isolate example.com --max-conns 20 --mem-limit 512M
  wp-isolate restore example.com
  wp-isolate status example.com
EOF
}

cmd_list() {
    init_storage
    printf "%-25s | %-10s | %-20s | %-8s | %-10s | %-10s\n" "DOMAIN" "STATUS" "LINUX USER" "PHP VER" "MAX CONNS" "REDIS DB"
    echo "-------------------------------------------------------------------------------------------------------------"

    local domains=()
    local vhost_panel_dir="${AAPANEL_OLS_VHOST_DIR:-/www/server/panel/vhost/openlitespeed}"
    local wwwroot_dir="${AAPANEL_WWWROOT_DIR:-/www/wwwroot}"

    # Discover domains from aaPanel OLS directory
    if [ -d "$vhost_panel_dir" ]; then
        for f in "$vhost_panel_dir"/*.conf; do
            [ -e "$f" ] || continue
            local d
            d=$(basename "$f" .conf)
            [[ "$d" =~ ^(default|0\.default|phpmyadmin|localhost)$ ]] && continue
            domains+=("$d")
        done
    fi

    # Fallback to scanning wwwroot
    if [ ${#domains[@]} -eq 0 ] && [ -d "$wwwroot_dir" ]; then
        for d in "$wwwroot_dir"/*; do
            [ -d "$d" ] || continue
            local name
            name=$(basename "$d")
            [[ "$name" =~ ^(default|phpmyadmin)$ ]] && continue
            domains+=("$name")
        done
    fi

    if [ ${#domains[@]} -eq 0 ]; then
        log_info "No websites found on aaPanel."
        return 0
    fi

    for domain in "${domains[@]}"; do
        local outer_file="${vhost_panel_dir}/${domain}.conf"
        local detail_file="${vhost_panel_dir}/detail/${domain}.conf"
        local status="DEFAULT"
        local user="www"
        local php_ver="-"
        local max_conns="-"
        local redis_db="-"

        local vhost_file
        vhost_file=$(detect_ols_vhost_file "$domain" 2>/dev/null || true)
        local docroot
        docroot=$(detect_vhost_docroot "$domain" "$vhost_file" 2>/dev/null || echo "/www/wwwroot/${domain}")

        if ([ -f "$detail_file" ] && grep -qE "extUser\s+iso_" "$detail_file" 2>/dev/null) || \
           ([ -f "$outer_file" ] && grep -qE "setUIDMode\s+2|WP-ISOLATE" "$outer_file" 2>/dev/null); then
            status="ISOLATED"
            user=$(get_site_user "$domain")
            php_ver=$(detect_php_version "$domain")
            if [ -f "$detail_file" ]; then
                max_conns=$(grep -E "^\s*maxConns\s+" "$detail_file" | awk '{print $2}' || echo "-")
            fi
        fi

        if [ -f "$docroot/wp-config.php" ]; then
            local r_val
            r_val=$(extract_wp_redis_db "$docroot/wp-config.php" 2>/dev/null || true)
            if [ -n "$r_val" ]; then
                redis_db="DB ${r_val}"
            fi
        fi

        printf "%-25s | %-10s | %-20s | %-8s | %-10s | %-10s\n" "$domain" "$status" "$user" "$php_ver" "$max_conns" "$redis_db"
    done
}

cmd_isolate() {
    local domain=""
    local max_conns=15
    local mem_limit="512M"
    local db_limit=25
    local req_limit=10
    local custom_docroot=""
    local custom_redis_db=""
    local enable_redis=true

    while [ $# -gt 0 ]; do
        case "$1" in
            --max-conns) max_conns="$2"; shift 2 ;;
            --mem-limit) mem_limit="$2"; shift 2 ;;
            --db-limit) db_limit="$2"; shift 2 ;;
            --req-limit) req_limit="$2"; shift 2 ;;
            --redis-db) custom_redis_db="$2"; shift 2 ;;
            --no-redis) enable_redis=false; shift 1 ;;
            --docroot) custom_docroot="$2"; shift 2 ;;
            -*) log_error "Unknown option: $1"; exit 1 ;;
            *)
                if [ -z "$domain" ]; then
                    domain="$1"
                    shift
                else
                    log_error "Unexpected argument: $1"; exit 1
                fi
                ;;
        esac
    done

    if [ -z "$domain" ]; then
        log_error "Domain name is required. Example: wp-isolate isolate example.com"
        exit 1
    fi

    init_storage

    local vhost_file
    vhost_file=$(detect_ols_vhost_file "$domain" 2>/dev/null || true)
    if [ -z "$vhost_file" ] || [ ! -f "$vhost_file" ]; then
        log_error "Could not find OpenLiteSpeed vhost file for $domain in aaPanel."
        return 1
    fi

    local docroot="${custom_docroot:-}"
    if [ -z "$docroot" ]; then
        docroot=$(detect_vhost_docroot "$domain" "$vhost_file" 2>/dev/null || true)
    fi

    if [ -z "$docroot" ] || [ ! -d "$docroot" ]; then
        log_error "Website root directory ($docroot) not found for $domain."
        return 1
    fi

    log_info "Starting isolation for website: $domain"

    # Step 1: Pre-flight Backup
    local timestamp
    timestamp=$(date +%Y%m%d%H%M%S)
    local backup_dir="${BACKUPS_DIR}/${domain}/${timestamp}"
    mkdir -p "$backup_dir"
    local outer_file="/www/server/panel/vhost/openlitespeed/${domain}.conf"
    local detail_file="/www/server/panel/vhost/openlitespeed/detail/${domain}.conf"
    [ -f "$outer_file" ] && cp "$outer_file" "${backup_dir}/vhost.conf"
    [ -f "$detail_file" ] && cp "$detail_file" "${backup_dir}/detail.conf"
    log_info "Saved pre-flight backup to ${backup_dir}/"

    # Step 2: Create Linux System User
    create_isolated_user "$domain" "$docroot"

    # Step 3: Apply Permissions & POSIX ACL
    apply_site_permissions "$domain" "$docroot"

    # Step 4: Configure OpenLiteSpeed suEXEC and Limits (both outer and detail configs)
    local user
    user=$(get_site_user "$domain")
    isolate_ols_vhost "$domain" "$user" "$max_conns" "$mem_limit" "$req_limit" "$docroot"

    # Step 5: Limit MySQL Database Connections
    local db_user
    db_user=$(extract_wp_db_user "$docroot" 2>/dev/null || true)
    if [ -n "$db_user" ]; then
        set_mysql_user_limit "$db_user" "$db_limit"
    fi

    # Step 6: Configure Redis Cache Isolation
    local redis_db=""
    if [ "$enable_redis" = true ] && ([ -f "$docroot/wp-config.php" ] || is_redis_available); then
        ensure_redis_databases 64
        if [ -n "$custom_redis_db" ]; then
            redis_db="$custom_redis_db"
        else
            # Reuse existing assigned database ID if already configured, otherwise allocate next available
            redis_db=$(get_existing_wp_redis_db "$domain" "$docroot" "$SITES_REGISTRY" 2>/dev/null || true)
            if [ -z "$redis_db" ]; then
                redis_db=$(get_next_available_redis_db "$SITES_REGISTRY" "$domain")
            fi
        fi
        apply_wp_redis_config "$domain" "$docroot" "$redis_db"
    fi

    # Step 7: Syntax Verification & Graceful Reload (Fail-Safe Rollback Engine)
    if ! verify_and_reload_ols; then
        log_error "OpenLiteSpeed validation failed! Initiating IMMEDIATE AUTO-ROLLBACK..."
        [ -f "${backup_dir}/vhost.conf" ] && cp "${backup_dir}/vhost.conf" "$outer_file"
        [ -f "${backup_dir}/detail.conf" ] && cp "${backup_dir}/detail.conf" "$detail_file"
        if [ -n "$redis_db" ]; then
            remove_wp_redis_config "$domain" "$docroot" "$redis_db"
        fi
        restore_site_permissions "$domain" "$docroot"
        remove_isolated_user "$domain"
        verify_and_reload_ols || true
        log_error "Rollback complete. System returned to pre-isolation state."
        return 1
    fi

    # Warm up site with an HTTP/HTTPS request so WordPress and LiteSpeed Cache immediately connect and populate Redis
    if [ "$enable_redis" = true ] && command -v curl >/dev/null 2>&1; then
        curl -s -k -m 5 --resolve "${domain}:80:127.0.0.1" --resolve "${domain}:443:127.0.0.1" "https://${domain}/" >/dev/null 2>&1 || \
        curl -s -k -m 5 --resolve "${domain}:80:127.0.0.1" --resolve "${domain}:443:127.0.0.1" "http://${domain}/" >/dev/null 2>&1 || \
        curl -s -k -m 5 -H "Host: ${domain}" "http://127.0.0.1/" >/dev/null 2>&1 || true
    fi

    update_site_registry "$domain" "$user" "${redis_db:-}"
    log_success "Website $domain successfully ISOLATED!"
}

cmd_restore() {
    local domain="${1:-}"
    if [ -z "$domain" ]; then
        log_error "Domain name is required. Example: wp-isolate restore example.com"
        exit 1
    fi

    init_storage
    local vhost_file
    vhost_file=$(detect_ols_vhost_file "$domain" 2>/dev/null || true)
    local docroot
    docroot=$(detect_vhost_docroot "$domain" "$vhost_file" 2>/dev/null || echo "/www/wwwroot/${domain}")

    log_info "Restoring website $domain to standard aaPanel configuration..."

    restore_ols_vhost "$domain"
    restore_site_permissions "$domain" "$docroot"

    local db_user
    db_user=$(extract_wp_db_user "$docroot" 2>/dev/null || true)
    if [ -n "$db_user" ]; then
        remove_mysql_user_limit "$db_user"
    fi

    # Remove Redis cache configuration and flush isolated DB
    local redis_db=""
    if [ -f "$docroot/wp-config.php" ]; then
        redis_db=$(extract_wp_redis_db "$docroot/wp-config.php" 2>/dev/null || true)
    fi
    remove_wp_redis_config "$domain" "$docroot" "$redis_db"
    remove_from_registry "$domain"

    remove_isolated_user "$domain"
    rm -rf "${VHOSTS_DIR:?}/${domain}" 2>/dev/null || true

    verify_and_reload_ols
    log_success "Website $domain restored to standard aaPanel state."
}

cmd_status() {
    local domain="${1:-}"
    if [ -z "$domain" ]; then
        log_error "Domain name is required. Example: wp-isolate status example.com"
        exit 1
    fi

    local user
    user=$(get_site_user "$domain")
    local vhost_file
    vhost_file=$(detect_ols_vhost_file "$domain" 2>/dev/null || true)
    local docroot
    docroot=$(detect_vhost_docroot "$domain" "$vhost_file" 2>/dev/null || echo "${AAPANEL_WWWROOT_DIR:-/www/wwwroot}/${domain}")

    echo "=========================================================="
    echo "  ISOLATION STATUS FOR: ${domain}"
    echo "=========================================================="
    if [ -n "$vhost_file" ] && grep -q "WP-ISOLATE: ${domain}" "$vhost_file" 2>/dev/null; then
        echo "Status:              ISOLATED"
        echo "Linux User:          $user"
        echo "Document Root:       $docroot"
        echo "VHost Config:        $vhost_file"
        local detail_file="/www/server/panel/vhost/openlitespeed/detail/${domain}.conf"
        if [ -f "$detail_file" ]; then
            echo "Isolated Config:     $detail_file"
            echo "Max PHP Conns:       $(grep -E "^\s*maxConns" "$detail_file" | awk '{print $2}' || echo "-")"
            echo "Mem Soft/Hard:       $(grep -E "^\s*memSoftLimit" "$detail_file" | awk '{print $2}' || echo "-") / $(grep -E "^\s*memHardLimit" "$detail_file" | awk '{print $2}' || echo "-")"
            echo "Per-Client Limit:    $(grep 'perClientConnLimit' "$detail_file" | awk '{print $2}' || echo "-")"
            echo "Dyn Req/Sec:         $(grep 'dynReqPerSec' "$detail_file" | awk '{print $2}' || echo "-")"
        fi
        local active_workers
        active_workers=$(pgrep -u "$user" 2>/dev/null | wc -l || echo "0")
        echo "Active PHP Workers:  $active_workers"

    else
        echo "Status:              DEFAULT (Shared user www:www)"
        echo "Document Root:       $docroot"
        echo "VHost Config:        ${vhost_file:-Not Found}"
    fi

    if [ -f "$docroot/wp-config.php" ]; then
        local r_val
        r_val=$(extract_wp_redis_db "$docroot/wp-config.php" 2>/dev/null || true)
        local r_salt
        r_salt=$(extract_wp_redis_salt "$docroot/wp-config.php" 2>/dev/null || true)
        if [ -n "$r_val" ]; then
            echo "Redis Database ID:   DB $r_val"
            [ -n "$r_salt" ] && echo "Redis Key Salt:      $r_salt"
            if [ -d "$docroot/wp-content/plugins/litespeed-cache" ]; then
                echo "LiteSpeed Cache:     Synchronized (DB $r_val)"
            fi
        else
            echo "Redis Database:      Not configured"
        fi
    fi
    echo "=========================================================="
}

cmd_verify() {
    log_info "Auditing isolation configuration across all websites..."
    local issues=0
    if [ -d "$VHOSTS_DIR" ]; then
        for d in "$VHOSTS_DIR"/*; do
            [ -d "$d" ] || continue
            local domain
            domain=$(basename "$d")
            local detail_file="/www/server/panel/vhost/openlitespeed/detail/${domain}.conf"
            if [ ! -f "$detail_file" ] || ! grep -q "WP-ISOLATE: ${domain}" "$detail_file" 2>/dev/null; then
                log_warn "Configuration drift detected: $domain isolation limits are missing in $detail_file!"
                issues=$((issues + 1))
            fi
        done
    fi

    if [ "$issues" -eq 0 ]; then
        log_success "Audit completed. All isolated sites have intact configurations."
    else
        log_warn "Found $issues issue(s). Run 'wp-isolate repair [domain]' to fix."
    fi
}

cmd_repair() {
    local target_domain="${1:-}"
    if [ -n "$target_domain" ]; then
        local user
        user=$(get_site_user "$target_domain")
        local docroot="/www/wwwroot/${target_domain}"
        isolate_ols_vhost "$target_domain" "$user" 15 "512M" 10 "$docroot"
        apply_site_permissions "$target_domain" "$docroot"
        verify_and_reload_ols
        log_success "Repaired $target_domain."
    else
        log_info "Repairing all isolated websites..."
        for d in "$VHOSTS_DIR"/*; do
            [ -d "$d" ] || continue
            local domain
            domain=$(basename "$d")
            local user
            user=$(get_site_user "$domain")
            local docroot="/www/wwwroot/${domain}"
            isolate_ols_vhost "$domain" "$user" 15 "512M" 10 "$docroot"
            apply_site_permissions "$domain" "$docroot"
        done
        verify_and_reload_ols
        log_success "All isolated websites repaired."
    fi
}

cmd_healer() {
    local action="${1:-enable}"
    local svc_file="/etc/systemd/system/wp-isolate-healer.service"
    local bin_path="${SCRIPT_DIR}/bin/wp-isolate-healer"
    
    chmod +x "$bin_path"
    
    if [ "$action" = "enable" ]; then
        cat <<EOF > "$svc_file"
[Unit]
Description=WP-Isolate 503 Auto-Healer Daemon
After=network.target lsws.service

[Service]
Type=simple
ExecStart=${bin_path}
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
EOF
        systemctl daemon-reload
        systemctl enable wp-isolate-healer.service
        systemctl restart wp-isolate-healer.service
        log_success "Auto-Healer daemon is now ENABLED and running in the background."
        log_info "It will instantly detect 503 crashes and automatically repair them!"
    elif [ "$action" = "disable" ]; then
        systemctl stop wp-isolate-healer.service 2>/dev/null || true
        systemctl disable wp-isolate-healer.service 2>/dev/null || true
        rm -f "$svc_file"
        systemctl daemon-reload
        log_success "Auto-Healer daemon has been DISABLED."
    else
        log_error "Usage: wp-isolate healer [enable|disable]"
        exit 1
    fi
}

cmd_clean() {
    local target_domain="${1:-}"
    if [ -z "$target_domain" ]; then
        log_error "Usage: wp-isolate clean <domain>"
        exit 1
    fi

    log_info "Cleaning up stale cache and sockets for $target_domain..."
    local docroot="/www/wwwroot/${target_domain}"
    
    if [ ! -d "$docroot" ]; then
        log_error "Directory $docroot does not exist!"
        exit 1
    fi

    # 1. Xóa rác Object Cache
    rm -f "${docroot}/wp-content/object-cache.php" 2>/dev/null || true
    rm -f "${docroot}/wp-content/advanced-cache.php" 2>/dev/null || true
    
    # 2. Xóa .user.ini cũ nếu có (aaPanel thường khóa chattr +i file này)
    chattr -i "${docroot}/.user.ini" 2>/dev/null || true
    rm -f "${docroot}/.user.ini" 2>/dev/null || true

    # 3. Tắt WP_CACHE trong wp-config.php
    if [ -f "${docroot}/wp-config.php" ]; then
        sed_i -E "s/define\([[:space:]]*['\"]WP_CACHE['\"].*/define( 'WP_CACHE', false );/g" "${docroot}/wp-config.php" || true
    fi

    # 4. Xóa Socket kẹt quyền của LiteSpeed
    rm -f "/tmp/lshttpd/${target_domain}"* 2>/dev/null || true

    # 5. Phân quyền và cô lập lại
    local user
    user=$(get_site_user "$target_domain")
    isolate_ols_vhost "$target_domain" "$user" 15 "512M" 10 "$docroot"
    apply_site_permissions "$target_domain" "$docroot"

    # 6. Khởi động lại PHP
    killall -9 lsphp 2>/dev/null || true
    systemctl restart lsws 2>/dev/null || true

    log_success "Cleaned and repaired $target_domain perfectly!"
}

cmd_isolate_all() {
    local force=false
    local args=()
    for arg in "$@"; do
        if [ "$arg" = "--force" ] || [ "$arg" = "-f" ]; then
            force=true
        else
            args+=("$arg")
        fi
    done

    log_info "Running global PHP Configuration optimizations..."
    optimize_global_php_config

    log_info "Scanning for websites on aaPanel..."
    local count=0
    local domains=()
    local vhost_panel_dir="${AAPANEL_OLS_VHOST_DIR:-/www/server/panel/vhost/openlitespeed}"
    local wwwroot_dir="${AAPANEL_WWWROOT_DIR:-/www/wwwroot}"

    # Discover domains from aaPanel OLS directory
    if [ -d "$vhost_panel_dir" ]; then
        for f in "$vhost_panel_dir"/*.conf; do
            [ -e "$f" ] || continue
            local d
            d=$(basename "$f" .conf)
            [[ "$d" =~ ^(default|0\.default|phpmyadmin|localhost)$ ]] && continue
            domains+=("$d")
        done
    fi

    # Fallback to scanning wwwroot
    if [ ${#domains[@]} -eq 0 ] && [ -d "$wwwroot_dir" ]; then
        for d in "$wwwroot_dir"/*; do
            [ -d "$d" ] || continue
            local name
            name=$(basename "$d")
            [[ "$name" =~ ^(default|phpmyadmin)$ ]] && continue
            domains+=("$name")
        done
    fi

    if [ ${#domains[@]} -eq 0 ]; then
        log_info "No websites found on aaPanel."
        return 0
    fi

    for domain in "${domains[@]}"; do
        local f="${vhost_panel_dir}/${domain}.conf"
        local detail_file="${vhost_panel_dir}/detail/${domain}.conf"
        local is_already_isolated=false

        if [ -f "$detail_file" ] && grep -qE "^\s*extUser\s+iso_" "$detail_file" 2>/dev/null && grep -q "setUIDMode 2" "$f" 2>/dev/null; then
            is_already_isolated=true
        fi

        local docroot
        docroot=$(detect_vhost_docroot "$domain" "$f" 2>/dev/null || echo "${wwwroot_dir}/${domain}")

        local needs_redis_update=false
        if [ -f "$docroot/wp-config.php" ]; then
            if ! extract_wp_redis_db "$docroot/wp-config.php" >/dev/null 2>&1; then
                needs_redis_update=true
            fi
        fi

        if [ "$is_already_isolated" = true ] && [ "$force" = false ]; then
            if [ "$needs_redis_update" = true ]; then
                log_info "Website $domain is isolated but missing Redis cache configuration. Updating..."
                if cmd_isolate "$domain" "${args[@]}"; then
                    count=$((count + 1))
                fi
            else
                log_info "Website $domain is already fully isolated. (Use --force to re-apply)"
            fi
            continue
        fi

        log_info "Isolating $domain..."
        if cmd_isolate "$domain" "${args[@]}"; then
            count=$((count + 1))
        else
            log_warn "Failed to isolate $domain. Continuing to next website..."
        fi
    done
    log_success "Processed $count website(s)."
}

# Main command dispatcher
ACTION="${1:-help}"
shift || true

case "$ACTION" in
    list)        cmd_list "$@" ;;
    isolate)     cmd_isolate "$@" ;;
    isolate-all) cmd_isolate_all "$@" ;;
    restore)     cmd_restore "$@" ;;
    status)      cmd_status "$@" ;;
    verify)      cmd_verify "$@" ;;
    repair)      cmd_repair "$@" ;;
    clean)       cmd_clean "$@" ;;
    healer)      cmd_healer "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
        log_error "Unknown command: $ACTION"
        cmd_help
        exit 1
        ;;
esac
