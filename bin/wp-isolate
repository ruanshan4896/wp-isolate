#!/usr/bin/env bash
# bin/wp-isolate - aaPanel OpenLiteSpeed Website Isolation Utility
set -eu
set -o pipefail 2>/dev/null || true

# Resolve real path of the script even when executed via symlink
TARGET_SCRIPT="${BASH_SOURCE[0]}"
if [ -h "$TARGET_SCRIPT" ] || command -v readlink >/dev/null 2>&1; then
    TARGET_SCRIPT="$(readlink -f "$TARGET_SCRIPT" 2>/dev/null || realpath "$TARGET_SCRIPT" 2>/dev/null || echo "$TARGET_SCRIPT")"
fi
SCRIPT_DIR="$(cd "$(dirname "$TARGET_SCRIPT")/.." && pwd)"

# Fallback to standard installation directory if lib is not in SCRIPT_DIR
if [ ! -d "${SCRIPT_DIR}/lib" ] && [ -d "/opt/wp-isolate/lib" ]; then
    SCRIPT_DIR="/opt/wp-isolate"
fi

# Source libraries
source "${SCRIPT_DIR}/lib/common.sh"
source "${SCRIPT_DIR}/lib/os_user.sh"
source "${SCRIPT_DIR}/lib/ols_vhost.sh"
source "${SCRIPT_DIR}/lib/mysql_limit.sh"

# Paths
BASE_DIR="${WP_ISOLATE_DIR:-/opt/wp-isolate}"
VHOSTS_DIR="${BASE_DIR}/vhosts"
BACKUPS_DIR="${BASE_DIR}/backups"
DATA_DIR="${BASE_DIR}/data"
SITES_REGISTRY="${DATA_DIR}/sites.json"

init_storage() {
    mkdir -p "$VHOSTS_DIR" "$BACKUPS_DIR" "$DATA_DIR"
    if [ ! -f "$SITES_REGISTRY" ]; then
        echo "{}" > "$SITES_REGISTRY"
    fi
}

update_site_registry() {
    local domain="$1"
    local user="$2"
    local reg="${SITES_REGISTRY:-/opt/wp-isolate/data/sites.json}"
    mkdir -p "$(dirname "$reg")"
    if [ ! -f "$reg" ]; then echo "{}" > "$reg"; fi
    
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "
import json, sys
reg_file, domain, user = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(reg_file, 'r') as f:
        data = json.load(f)
except Exception:
    data = {}
data[domain] = {'user': user}
with open(reg_file, 'w') as f:
    json.dump(data, f, indent=2)
" "$reg" "$domain" "$user" 2>/dev/null || true
    fi
}

remove_from_registry() {
    local domain="$1"
    local reg="${SITES_REGISTRY:-/opt/wp-isolate/data/sites.json}"
    if [ -f "$reg" ] && command -v python3 >/dev/null 2>&1; then
        python3 -c "
import json, sys
reg_file, domain = sys.argv[1], sys.argv[2]
try:
    with open(reg_file, 'r') as f:
        data = json.load(f)
    if domain in data:
        del data[domain]
    with open(reg_file, 'w') as f:
        json.dump(data, f, indent=2)
except Exception:
    pass
" "$reg" "$domain" 2>/dev/null || true
    fi
}

cmd_help() {
    cat << 'EOF'
Usage: wp-isolate <command> [arguments] [options]

Core Commands:
  list                          List all websites and their isolation status
  isolate <domain> [options]    Isolate a website with dedicated suEXEC user and limits
  isolate-all [options]         Isolate all websites (use --force to re-apply to all)
  restore <domain>              Revert website back to default aaPanel (www:www)
  status <domain>               Display detailed isolation status and metrics
  verify                        Audit system integrity and check for configuration drift
  repair [domain]               Re-apply isolated configuration hooks
  clean <domain|all>            Purge stale cache, broken sockets & lockfiles to resolve 503s
  scan <domain|all>             Scan and clean rogue PHP in uploads, inspect .user.ini
  sentinel <enable|disable|status> Manage unified zero-touch sentinel (auto-isolation & healing)

Options for 'isolate':
  --max-conns <num>             Max concurrent PHP workers (Default: 15)
  --mem-limit <size>            OpenLiteSpeed virtual memory limit per site (Default: 2047M)
  --db-limit <num>              Max MySQL connections for site DB user (Default: 25)
  --req-limit <num>             Max dynamic requests/sec per client IP (Default: 10)
  --docroot <path>              Override website document root path

Examples:
  wp-isolate list
  wp-isolate isolate example.com --max-conns 20 --mem-limit 512M
  wp-isolate restore example.com
  wp-isolate clean example.com
  wp-isolate sentinel enable
  wp-isolate status example.com
EOF
}

cmd_list() {
    init_storage
    printf "%-25s | %-10s | %-20s | %-8s | %-10s\n" "DOMAIN" "STATUS" "LINUX USER" "PHP VER" "MAX CONNS"
    echo "---------------------------------------------------------------------------------------------------"

    local domains=()
    local vhost_panel_dir="${AAPANEL_OLS_VHOST_DIR:-/www/server/panel/vhost/openlitespeed}"
    local wwwroot_dir="${AAPANEL_WWWROOT_DIR:-/www/wwwroot}"

    # Discover domains from aaPanel OLS directory
    if [ -d "$vhost_panel_dir" ]; then
        for f in "$vhost_panel_dir"/*.conf; do
            [ -e "$f" ] || continue
            local d
            d=$(basename "$f" .conf)
            [[ "$d" =~ ^(default|0\.default|phpmyadmin|localhost)$ ]] && continue
            domains+=("$d")
        done
    fi

    # Fallback to scanning wwwroot
    if [ ${#domains[@]} -eq 0 ] && [ -d "$wwwroot_dir" ]; then
        for d in "$wwwroot_dir"/*; do
            [ -d "$d" ] || continue
            local name
            name=$(basename "$d")
            [[ "$name" =~ ^(default|phpmyadmin)$ ]] && continue
            domains+=("$name")
        done
    fi

    if [ ${#domains[@]} -eq 0 ]; then
        log_info "No websites found on aaPanel."
        return 0
    fi

    for domain in "${domains[@]}"; do
        local outer_file="${vhost_panel_dir}/${domain}.conf"
        local detail_file="${vhost_panel_dir}/detail/${domain}.conf"
        local status="DEFAULT"
        local user="www"
        local php_ver="-"
        local max_conns="-"

        local vhost_file
        vhost_file=$(detect_ols_vhost_file "$domain" 2>/dev/null || true)
        local docroot
        docroot=$(detect_vhost_docroot "$domain" "$vhost_file" 2>/dev/null || echo "/www/wwwroot/${domain}")

        if ([ -f "$detail_file" ] && grep -qE "extUser\s+iso_" "$detail_file" 2>/dev/null) || \
           ([ -f "$outer_file" ] && grep -qE "setUIDMode\s+2|WP-ISOLATE" "$outer_file" 2>/dev/null); then
            status="ISOLATED"
            user=$(get_site_user "$domain")
            php_ver=$(detect_php_version "$domain")
            if [ -f "$detail_file" ]; then
                max_conns=$(grep -E "^\s*maxConns\s+" "$detail_file" | awk '{print $2}' || echo "-")
            fi
        fi

        printf "%-25s | %-10s | %-20s | %-8s | %-10s\n" "$domain" "$status" "$user" "$php_ver" "$max_conns"
    done
}

cmd_isolate() {
    local domain=""
    local max_conns=15
    local mem_limit="2047M"
    local db_limit=25
    local req_limit=10
    local custom_docroot=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --max-conns) max_conns="$2"; shift 2 ;;
            --mem-limit) mem_limit="$2"; shift 2 ;;
            --db-limit) db_limit="$2"; shift 2 ;;
            --req-limit) req_limit="$2"; shift 2 ;;
            --docroot) custom_docroot="$2"; shift 2 ;;
            -*) log_error "Unknown option: $1"; exit 1 ;;
            *)
                if [ -z "$domain" ]; then
                    domain="$1"
                    shift
                else
                    log_error "Unexpected argument: $1"; exit 1
                fi
                ;;
        esac
    done

    if [ -z "$domain" ]; then
        log_error "Domain name is required. Example: wp-isolate isolate example.com"
        exit 1
    fi

    init_storage

    local vhost_file
    vhost_file=$(detect_ols_vhost_file "$domain" 2>/dev/null || true)
    if [ -z "$vhost_file" ] || [ ! -f "$vhost_file" ]; then
        log_error "Could not find OpenLiteSpeed vhost file for $domain in aaPanel."
        return 1
    fi

    local docroot="${custom_docroot:-}"
    if [ -z "$docroot" ]; then
        docroot=$(detect_vhost_docroot "$domain" "$vhost_file" 2>/dev/null || true)
    fi

    if [ -z "$docroot" ] || [ ! -d "$docroot" ]; then
        log_error "Website root directory ($docroot) not found for $domain."
        return 1
    fi

    log_info "Starting isolation for website: $domain"

    # Step 1: Pre-flight Backup
    local timestamp
    timestamp=$(date +%Y%m%d%H%M%S)
    local backup_dir="${BACKUPS_DIR}/${domain}/${timestamp}"
    mkdir -p "$backup_dir"
    local vhost_panel_dir="${AAPANEL_OLS_VHOST_DIR:-/www/server/panel/vhost/openlitespeed}"
    local outer_file="${vhost_panel_dir}/${domain}.conf"
    local detail_file="${vhost_panel_dir}/detail/${domain}.conf"
    [ -f "$outer_file" ] && cp "$outer_file" "${backup_dir}/vhost.conf"
    [ -f "$detail_file" ] && cp "$detail_file" "${backup_dir}/detail.conf"
    log_info "Saved pre-flight backup to ${backup_dir}/"

    # Step 2: Create Linux System User
    create_isolated_user "$domain" "$docroot"

    # Step 3: Apply Permissions & POSIX ACL
    apply_site_permissions "$domain" "$docroot"

    # Step 4: Configure OpenLiteSpeed suEXEC and Limits (both outer and detail configs)
    local user
    user=$(get_site_user "$domain")
    isolate_ols_vhost "$domain" "$user" "$max_conns" "$mem_limit" "$req_limit" "$docroot"

    # Step 5: Limit MySQL Database Connections
    local db_user
    db_user=$(extract_wp_db_user "$docroot" 2>/dev/null || true)
    if [ -n "$db_user" ]; then
        set_mysql_user_limit "$db_user" "$db_limit"
    fi

    # Step 6: Purge Legacy Redis Configuration (Pure Isolation Model)
    purge_legacy_redis_config "$domain" "$docroot"

    # Step 7: Syntax Verification & Graceful Reload (Fail-Safe Rollback Engine)
    if ! verify_and_reload_ols; then
        log_error "OpenLiteSpeed validation failed! Initiating IMMEDIATE AUTO-ROLLBACK..."
        [ -f "${backup_dir}/vhost.conf" ] && cp "${backup_dir}/vhost.conf" "$outer_file"
        [ -f "${backup_dir}/detail.conf" ] && cp "${backup_dir}/detail.conf" "$detail_file"
        purge_legacy_redis_config "$domain" "$docroot"
        restore_site_permissions "$domain" "$docroot"
        remove_isolated_user "$domain"
        verify_and_reload_ols || true
        log_error "Rollback complete. System returned to pre-isolation state."
        return 1
    fi

    update_site_registry "$domain" "$user"
    log_success "Website $domain successfully ISOLATED!"
}

cmd_restore() {
    local domain="${1:-}"
    if [ -z "$domain" ]; then
        log_error "Domain name is required. Example: wp-isolate restore example.com"
        exit 1
    fi

    init_storage
    local vhost_file
    vhost_file=$(detect_ols_vhost_file "$domain" 2>/dev/null || true)
    local docroot
    docroot=$(detect_vhost_docroot "$domain" "$vhost_file" 2>/dev/null || echo "/www/wwwroot/${domain}")

    log_info "Restoring website $domain to standard aaPanel configuration..."

    restore_ols_vhost "$domain"
    restore_site_permissions "$domain" "$docroot"

    local db_user
    db_user=$(extract_wp_db_user "$docroot" 2>/dev/null || true)
    if [ -n "$db_user" ]; then
        remove_mysql_user_limit "$db_user"
    fi

    # Purge legacy Redis configuration and drop-ins
    purge_legacy_redis_config "$domain" "$docroot"
    remove_from_registry "$domain"

    remove_isolated_user "$domain"
    rm -rf "${VHOSTS_DIR:?}/${domain}" 2>/dev/null || true

    verify_and_reload_ols
    log_success "Website $domain restored to standard aaPanel state."
}

cmd_status() {
    local domain="${1:-}"
    if [ -z "$domain" ]; then
        log_error "Domain name is required. Example: wp-isolate status example.com"
        exit 1
    fi

    local user
    user=$(get_site_user "$domain")
    local vhost_file
    vhost_file=$(detect_ols_vhost_file "$domain" 2>/dev/null || true)
    local docroot
    docroot=$(detect_vhost_docroot "$domain" "$vhost_file" 2>/dev/null || echo "${AAPANEL_WWWROOT_DIR:-/www/wwwroot}/${domain}")
    local vhost_panel_dir="${AAPANEL_OLS_VHOST_DIR:-/www/server/panel/vhost/openlitespeed}"
    local outer_file="${vhost_panel_dir}/${domain}.conf"
    local detail_file="${vhost_panel_dir}/detail/${domain}.conf"

    echo "=========================================================="
    echo "  ISOLATION STATUS FOR: ${domain}"
    echo "=========================================================="
    local is_isolated=false
    if ([ -f "$detail_file" ] && grep -qE "extUser\s+iso_|WP-ISOLATE" "$detail_file" 2>/dev/null) || \
       ([ -f "$outer_file" ] && grep -qE "setUIDMode\s+2|WP-ISOLATE" "$outer_file" 2>/dev/null); then
        is_isolated=true
    fi

    if [ "$is_isolated" = true ]; then
        echo "Status:              ISOLATED"
        echo "Linux User:          $user"
        echo "Document Root:       $docroot"
        echo "VHost Config:        ${vhost_file:-$outer_file}"
        if [ -f "$detail_file" ]; then
            echo "Isolated Config:     $detail_file"
            echo "Max PHP Conns:       $(grep -E "^\s*maxConns" "$detail_file" | awk '{print $2}' || echo "-")"
            echo "Mem Soft/Hard:       $(grep -E "^\s*memSoftLimit" "$detail_file" | awk '{print $2}' || echo "-") / $(grep -E "^\s*memHardLimit" "$detail_file" | awk '{print $2}' || echo "-")"
            echo "Per-Client Limit:    $(grep 'perClientConnLimit' "$detail_file" | awk '{print $2}' || echo "-")"
            echo "Dyn Req/Sec:         $(grep 'dynReqPerSec' "$detail_file" | awk '{print $2}' || echo "-")"
        fi
        local active_workers
        active_workers=$(pgrep -u "$user" 2>/dev/null | wc -l | tr -d ' ' || echo "0")
        echo "Active PHP Workers:  ${active_workers:-0}"

    else
        echo "Status:              DEFAULT (Shared user www:www)"
        echo "Document Root:       $docroot"
        echo "VHost Config:        ${vhost_file:-Not Found}"
    fi

    echo "=========================================================="
}

cmd_verify() {
    log_info "Auditing isolation configuration across all websites..."
    local issues=0
    local domains=()
    local vhost_panel_dir="${AAPANEL_OLS_VHOST_DIR:-/www/server/panel/vhost/openlitespeed}"
    local wwwroot_dir="${AAPANEL_WWWROOT_DIR:-/www/wwwroot}"
    local reg="${SITES_REGISTRY:-/opt/wp-isolate/data/sites.json}"

    # 1. Collect from sites.json registry
    if [ -f "$reg" ] && command -v python3 >/dev/null 2>&1; then
        while IFS= read -r d; do
            [ -n "$d" ] && domains+=("$d")
        done < <(python3 -c "
import json
try:
    with open('$reg') as f:
        data = json.load(f)
        for k in data.keys():
            print(k)
except Exception:
    pass
" 2>/dev/null || true)
    fi

    # 2. Collect from aaPanel vhost panel dir
    if [ -d "$vhost_panel_dir" ]; then
        for f in "$vhost_panel_dir"/*.conf; do
            [ -e "$f" ] || continue
            local d
            d=$(basename "$f" .conf)
            [[ "$d" =~ ^(default|0\.default|phpmyadmin|localhost)$ ]] && continue
            domains+=("$d")
        done
    fi

    if [ ${#domains[@]} -eq 0 ]; then
        log_info "No websites found to audit."
        return 0
    fi

    local unique_domains=()
    while IFS= read -r d; do
        [ -n "$d" ] && unique_domains+=("$d")
    done < <(printf "%s\n" "${domains[@]}" | sort -u)

    for domain in "${unique_domains[@]}"; do
        local outer_file="${vhost_panel_dir}/${domain}.conf"
        local detail_file="${vhost_panel_dir}/detail/${domain}.conf"
        local expected_user
        expected_user=$(get_site_user "$domain")
        local docroot
        docroot=$(detect_vhost_docroot "$domain" "$outer_file" 2>/dev/null || echo "${wwwroot_dir}/${domain}")

        # Check if site is supposed to be isolated
        local is_supposed_isolated=false
        if [ -f "$reg" ] && grep -q "\"${domain}\"" "$reg" 2>/dev/null; then
            is_supposed_isolated=true
        elif ([ -f "$outer_file" ] && grep -q "setUIDMode 2" "$outer_file" 2>/dev/null) || \
             ([ -f "$detail_file" ] && grep -qE "extUser\s+iso_" "$detail_file" 2>/dev/null); then
            is_supposed_isolated=true
        fi

        if [ "$is_supposed_isolated" = true ]; then
            local site_drift=false
            if [ ! -f "$detail_file" ] || ! grep -q "WP-ISOLATE: ${domain}" "$detail_file" 2>/dev/null; then
                log_warn "Configuration drift detected: $domain isolation limits are missing in $detail_file!"
                site_drift=true
            fi
            if [ ! -f "$outer_file" ] || ! grep -q "setUIDMode 2" "$outer_file" 2>/dev/null; then
                log_warn "Configuration drift detected: $domain suEXEC (setUIDMode 2) is missing in $outer_file!"
                site_drift=true
            fi
            if [ -d "$docroot" ] && [ "${EUID:-$(id -u)}" -eq 0 ]; then
                local owner
                owner=$(stat -c %U "$docroot" 2>/dev/null || stat -f %Su "$docroot" 2>/dev/null || echo "")
                if [ -n "$owner" ] && [ "$owner" != "$expected_user" ]; then
                    log_warn "Permission drift detected: $domain docroot owner is $owner, expected $expected_user!"
                    site_drift=true
                fi
            fi
            if [ "$site_drift" = true ]; then
                issues=$((issues + 1))
            fi
        fi
    done

    if [ "$issues" -eq 0 ]; then
        log_success "Audit completed. All isolated sites have intact configurations."
    else
        log_warn "Found $issues issue(s). Run 'wp-isolate repair [domain]' to fix."
    fi
}

cmd_repair() {
    local target_domain="${1:-}"
    local vhost_panel_dir="${AAPANEL_OLS_VHOST_DIR:-/www/server/panel/vhost/openlitespeed}"
    local wwwroot_dir="${AAPANEL_WWWROOT_DIR:-/www/wwwroot}"

    if [ -n "$target_domain" ]; then
        local user
        user=$(get_site_user "$target_domain")
        local outer_file="${vhost_panel_dir}/${target_domain}.conf"
        local docroot
        docroot=$(detect_vhost_docroot "$target_domain" "$outer_file" 2>/dev/null || echo "${wwwroot_dir}/${target_domain}")

        create_isolated_user "$target_domain" "$docroot"
        isolate_ols_vhost "$target_domain" "$user" 15 "2047M" 10 "$docroot"
        apply_site_permissions "$target_domain" "$docroot"
        purge_legacy_redis_config "$target_domain" "$docroot"
        update_site_registry "$target_domain" "$user"
        verify_and_reload_ols "$user"
        log_success "Repaired $target_domain."
    else
        log_info "Repairing all isolated websites..."
        local domains=()

        if [ -d "$vhost_panel_dir" ]; then
            for f in "$vhost_panel_dir"/*.conf; do
                [ -e "$f" ] || continue
                local d
                d=$(basename "$f" .conf)
                [[ "$d" =~ ^(default|0\.default|phpmyadmin|localhost)$ ]] && continue
                domains+=("$d")
            done
        fi
        if [ ${#domains[@]} -eq 0 ] && [ -d "$wwwroot_dir" ]; then
            for d in "$wwwroot_dir"/*; do
                [ -d "$d" ] || continue
                local name
                name=$(basename "$d")
                [[ "$name" =~ ^(default|phpmyadmin)$ ]] && continue
                domains+=("$name")
            done
        fi

        for domain in "${domains[@]}"; do
            local user
            user=$(get_site_user "$domain")
            local outer_file="${vhost_panel_dir}/${domain}.conf"
            local docroot
            docroot=$(detect_vhost_docroot "$domain" "$outer_file" 2>/dev/null || echo "${wwwroot_dir}/${domain}")

            create_isolated_user "$domain" "$docroot"
            isolate_ols_vhost "$domain" "$user" 15 "2047M" 10 "$docroot"
            apply_site_permissions "$domain" "$docroot"
            purge_legacy_redis_config "$domain" "$docroot"
            update_site_registry "$domain" "$user"
        done
        verify_and_reload_ols
        log_success "All isolated websites repaired."
    fi
}

cmd_sentinel() {
    local action="${1:-status}"
    local svc_file="/etc/systemd/system/wp-isolate-sentinel.service"
    local bin_path="${SCRIPT_DIR}/bin/wp-isolate-sentinel"

    chmod +x "$bin_path" 2>/dev/null || true

    case "$action" in
        enable|start)
            cat <<EOF > "$svc_file"
[Unit]
Description=WP-Isolate Zero-Touch Sentinel Daemon
After=network.target lsws.service

[Service]
Type=simple
ExecStart=${bin_path}
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
EOF
            # Stop legacy healer service if present to avoid dual runners
            systemctl stop wp-isolate-healer.service 2>/dev/null || true
            systemctl disable wp-isolate-healer.service 2>/dev/null || true
            rm -f "/etc/systemd/system/wp-isolate-healer.service" 2>/dev/null || true

            systemctl daemon-reload
            systemctl enable wp-isolate-sentinel.service
            systemctl restart wp-isolate-sentinel.service
            log_success "Zero-Touch Sentinel daemon is now ENABLED and active."
            log_info "It automatically isolates new aaPanel sites (45s debounce), heals 503s, and sanitizes uploads!"
            ;;
        disable|stop)
            systemctl stop wp-isolate-sentinel.service 2>/dev/null || true
            systemctl disable wp-isolate-sentinel.service 2>/dev/null || true
            rm -f "$svc_file"
            systemctl daemon-reload
            log_success "Sentinel daemon has been DISABLED."
            ;;
        restart)
            systemctl restart wp-isolate-sentinel.service 2>/dev/null || true
            log_success "Sentinel daemon restarted."
            ;;
        status)
            if systemctl is-active --quiet wp-isolate-sentinel.service 2>/dev/null; then
                log_success "Sentinel daemon is RUNNING."
            else
                log_warn "Sentinel daemon is NOT running."
            fi
            systemctl status wp-isolate-sentinel.service --no-pager 2>/dev/null || true
            ;;
        *)
            log_error "Usage: wp-isolate sentinel [enable|disable|restart|status]"
            exit 1
            ;;
    esac
}

scan_single_domain() {
    local target_domain="$1"
    local vhost_file
    vhost_file=$(detect_ols_vhost_file "$target_domain" 2>/dev/null || true)
    local docroot
    docroot=$(detect_vhost_docroot "$target_domain" "$vhost_file" 2>/dev/null || echo "/www/wwwroot/${target_domain}")

    if [ ! -d "$docroot" ]; then
        log_warn "Directory $docroot does not exist. Skipping $target_domain."
        return 0
    fi

    log_info "Scanning $target_domain for potential vulnerabilities and rogue files..."
    local found=0

    # 1. Check for rogue PHP files in wp-content/uploads/
    if [ -d "${docroot}/wp-content/uploads" ]; then
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            log_warn "MALWARE DETECTED: Rogue PHP file in uploads: $f"
            rm -f "$f" 2>/dev/null || true
            found=$((found + 1))
        done < <(find "${docroot}/wp-content/uploads" -type f \( -name "*.php" -o -name "*.phtml" -o -name "*.php[0-9]" -o -name "*.phps" \) 2>/dev/null || true)
    fi

    # 2. Check .user.ini for suspicious auto_prepend_file or auto_append_file
    if [ -f "${docroot}/.user.ini" ]; then
        if grep -qiE "auto_prepend_file|auto_append_file" "${docroot}/.user.ini" 2>/dev/null; then
            local is_legit_waf=false
            local prepended_target
            prepended_target=$(grep -iE "auto_prepend_file|auto_append_file" "${docroot}/.user.ini" | head -n 1 | sed -E "s/.*=[[:space:]]*['\"]?([^'\";]+)['\"]?.*/\1/" | tr -d ' ' || true)
            if [ -n "$prepended_target" ]; then
                if [[ "$prepended_target" =~ (wordfence-waf\.php|ninjafirewall) ]] && [ -f "$prepended_target" ]; then
                    is_legit_waf=true
                    log_info "Detected legitimate security WAF in .user.ini: $prepended_target"
                fi
            fi

            if [ "$is_legit_waf" = false ]; then
                log_warn "SUSPICIOUS DIRECTIVE: .user.ini contains unrecognized auto_prepend_file/auto_append_file. Neutralizing..."
                chattr -i "${docroot}/.user.ini" 2>/dev/null || true
                sed_i -E '/auto_prepend_file/Id;/auto_append_file/Id' "${docroot}/.user.ini" 2>/dev/null || true
                chattr +i "${docroot}/.user.ini" 2>/dev/null || true
                found=$((found + 1))
            fi
        fi
    fi

    # 3. Ensure .htaccess in uploads exists
    if [ -d "${docroot}/wp-content/uploads" ]; then
        local ht="${docroot}/wp-content/uploads/.htaccess"
        if [ ! -f "$ht" ] || ! grep -q "WP-ISOLATE UPLOADS SHIELD" "$ht" 2>/dev/null; then
            cat << 'HTEOF' >> "$ht"

# BEGIN WP-ISOLATE UPLOADS SHIELD
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|inc|pl|py|cgi)$">
Order Deny,Allow
Deny from all
</FilesMatch>
# END WP-ISOLATE UPLOADS SHIELD
HTEOF
            chmod 644 "$ht" 2>/dev/null || true
            log_info "Injected uploads PHP shield into $ht"
        fi
    fi

    if [ "$found" -eq 0 ]; then
        log_success "Scan completed for $target_domain: Clean (no rogue PHP files found)."
    else
        log_warn "Scan completed for $target_domain: Fixed $found issue(s)."
    fi
}

cmd_scan() {
    local target_domain="${1:-}"
    if [ -z "$target_domain" ]; then
        log_error "Usage: wp-isolate scan <domain|all>"
        exit 1
    fi

    if [ "$target_domain" = "all" ]; then
        log_info "Scanning all websites on server..."
        local vhost_panel_dir="${AAPANEL_OLS_VHOST_DIR:-/www/server/panel/vhost/openlitespeed}"
        local wwwroot_dir="${AAPANEL_WWWROOT_DIR:-/www/wwwroot}"

        if [ -d "$vhost_panel_dir" ]; then
            for f in "$vhost_panel_dir"/*.conf; do
                [ -e "$f" ] || continue
                local d
                d=$(basename "$f" .conf)
                [[ "$d" =~ ^(default|0\.default|phpmyadmin|localhost)$ ]] && continue
                scan_single_domain "$d"
            done
        fi
        log_success "Scan completed for all websites."
    else
        scan_single_domain "$target_domain"
    fi
}

clean_single_domain() {
    local target_domain="$1"
    local vhost_file
    vhost_file=$(detect_ols_vhost_file "$target_domain" 2>/dev/null || true)
    local docroot
    docroot=$(detect_vhost_docroot "$target_domain" "$vhost_file" 2>/dev/null || echo "/www/wwwroot/${target_domain}")

    if [ ! -d "$docroot" ]; then
        log_warn "Directory $docroot does not exist. Skipping $target_domain."
        return 0
    fi

    log_info "Cleaning up stale cache and sockets for $target_domain..."

    # 1. Purge legacy Redis config and drop-ins (object-cache only; page cache untouched)
    purge_legacy_redis_config "$target_domain" "$docroot"

    # NOTE: we intentionally do NOT touch advanced-cache.php, WP_CACHE or .user.ini here.
    # Those belong to LiteSpeed Cache / aaPanel; removing them on every 503 broke page cache
    # and fought with the plugin ("wp-config.php operation failed when changing WP_CACHE").

    # 2. Remove this site's stale LiteSpeed socket files only
    local clean_domain
    clean_domain=$(sanitize_domain_to_user "$target_domain")
    clean_domain="${clean_domain#iso_}"
    rm -f "/tmp/lshttpd/${target_domain}"* 2>/dev/null || true
    rm -f "/tmp/lshttpd/"*"${target_domain}"* 2>/dev/null || true
    rm -f "/tmp/lshttpd/"*"${clean_domain}"* 2>/dev/null || true

    # 3. Remove any rogue PHP files from uploads directory
    if [ -d "${docroot}/wp-content/uploads" ]; then
        find "${docroot}/wp-content/uploads" -type f \( -name "*.php" -o -name "*.phtml" -o -name "*.php[0-9]" -o -name "*.phps" \) -delete 2>/dev/null || true
    fi

    # 4. Re-apply vhost configuration (same limits as isolate: 2047M virtual memory)
    local user
    user=$(get_site_user "$target_domain")
    isolate_ols_vhost "$target_domain" "$user" 15 "2047M" 10 "$docroot"
    apply_site_permissions "$target_domain" "$docroot"

    log_success "Cleaned and repaired $target_domain."
}

cmd_clean() {
    local target_domain="${1:-}"
    if [ -z "$target_domain" ]; then
        log_error "Usage: wp-isolate clean <domain|all>"
        exit 1
    fi

    if [ "$target_domain" = "all" ]; then
        log_info "Cleaning all websites on server..."
        local vhost_panel_dir="${AAPANEL_OLS_VHOST_DIR:-/www/server/panel/vhost/openlitespeed}"
        local wwwroot_dir="${AAPANEL_WWWROOT_DIR:-/www/wwwroot}"
        local cleaned=0

        # Pass 1: Clean via aaPanel virtualhost configurations
        if [ -d "$vhost_panel_dir" ]; then
            for f in "$vhost_panel_dir"/*.conf; do
                [ -e "$f" ] || continue
                local d
                d=$(basename "$f" .conf)
                [[ "$d" =~ ^(default|0\.default|phpmyadmin|localhost)$ ]] && continue
                clean_single_domain "$d"
                cleaned=$((cleaned + 1))
            done
        fi

        # Pass 2: Comprehensive filesystem sweep on /www/wwwroot to catch all WordPress sites
        if [ -d "$wwwroot_dir" ]; then
            for site_dir in "$wwwroot_dir"/*; do
                [ -d "$site_dir" ] || continue
                local s_name
                s_name=$(basename "$site_dir")
                [[ "$s_name" =~ ^(default|phpmyadmin)$ ]] && continue
                if [ -f "${site_dir}/wp-config.php" ]; then
                    purge_legacy_redis_config "$s_name" "$site_dir"
                fi
            done
        fi

        pkill -9 -f lsphp 2>/dev/null || true
        verify_and_reload_ols
        log_success "Cleaned $cleaned website(s)."
    else
        clean_single_domain "$target_domain"
        # Only restart PHP workers of THIS site; killing all lsphp caused 503s on other sites,
        # which the sentinel then "healed" too -> cascading failures across the server.
        verify_and_reload_ols "$(get_site_user "$target_domain")"
        log_success "Cleaned and repaired $target_domain."
    fi
}

cmd_isolate_all() {
    local force=false
    local args=()
    for arg in "$@"; do
        if [ "$arg" = "--force" ] || [ "$arg" = "-f" ]; then
            force=true
        else
            args+=("$arg")
        fi
    done

    log_info "Running global PHP Configuration optimizations..."
    optimize_global_php_config

    log_info "Scanning for websites on aaPanel..."
    local count=0
    local domains=()
    local vhost_panel_dir="${AAPANEL_OLS_VHOST_DIR:-/www/server/panel/vhost/openlitespeed}"
    local wwwroot_dir="${AAPANEL_WWWROOT_DIR:-/www/wwwroot}"

    # Discover domains from aaPanel OLS directory
    if [ -d "$vhost_panel_dir" ]; then
        for f in "$vhost_panel_dir"/*.conf; do
            [ -e "$f" ] || continue
            local d
            d=$(basename "$f" .conf)
            [[ "$d" =~ ^(default|0\.default|phpmyadmin|localhost)$ ]] && continue
            domains+=("$d")
        done
    fi

    # Fallback to scanning wwwroot
    if [ ${#domains[@]} -eq 0 ] && [ -d "$wwwroot_dir" ]; then
        for d in "$wwwroot_dir"/*; do
            [ -d "$d" ] || continue
            local name
            name=$(basename "$d")
            [[ "$name" =~ ^(default|phpmyadmin)$ ]] && continue
            domains+=("$name")
        done
    fi

    if [ ${#domains[@]} -eq 0 ]; then
        log_info "No websites found on aaPanel."
        return 0
    fi

    for domain in "${domains[@]}"; do
        local f="${vhost_panel_dir}/${domain}.conf"
        local detail_file="${vhost_panel_dir}/detail/${domain}.conf"
        local is_already_isolated=false

        if [ -f "$detail_file" ] && grep -qE "^\s*extUser\s+iso_" "$detail_file" 2>/dev/null && grep -q "setUIDMode 2" "$f" 2>/dev/null; then
            is_already_isolated=true
        fi

        local docroot
        docroot=$(detect_vhost_docroot "$domain" "$f" 2>/dev/null || echo "${wwwroot_dir}/${domain}")

        if [ "$is_already_isolated" = true ] && [ "$force" = false ]; then
            log_info "Website $domain is already fully isolated. (Use --force to re-apply)"
            continue
        fi

        log_info "Isolating $domain..."
        if cmd_isolate "$domain" "${args[@]}"; then
            count=$((count + 1))
        else
            log_warn "Failed to isolate $domain. Continuing to next website..."
        fi
    done
    log_success "Processed $count website(s)."
}

# Main command dispatcher
ACTION="${1:-help}"
shift || true

case "$ACTION" in
    list)        cmd_list "$@" ;;
    isolate)     cmd_isolate "$@" ;;
    isolate-all) cmd_isolate_all "$@" ;;
    restore)     cmd_restore "$@" ;;
    status)      cmd_status "$@" ;;
    verify)      cmd_verify "$@" ;;
    repair)      cmd_repair "$@" ;;
    clean)       cmd_clean "$@" ;;
    scan)        cmd_scan "$@" ;;
    sentinel)    cmd_sentinel "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
        log_error "Unknown command: $ACTION"
        cmd_help
        exit 1
        ;;
esac
