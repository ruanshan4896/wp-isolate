#!/usr/bin/env bash
# bin/wp-isolate-healer - Auto-healer daemon for 503 errors

LOG_FILE="/usr/local/lsws/logs/error.log"
ISOLATE_CMD="/opt/wp-isolate/bin/wp-isolate"

if [ ! -f "$LOG_FILE" ]; then
    echo "Error log not found: $LOG_FILE"
    exit 1
fi

echo "Starting wp-isolate auto-healer daemon..."

tail -F "$LOG_FILE" | while read -r line; do
    if echo "$line" | grep -q "oops! 503 Service Unavailable"; then
        # Extract domain from format: ...#domain.com] oops!...
        domain=$(echo "$line" | sed -n 's/.*#\([^]]*\)\].*/\1/p')
        
        if [ -n "$domain" ]; then
            lock_file="/tmp/wp_isolate_healer_${domain}.lock"
            
            # Prevent infinite loops, only heal once per 60 seconds per domain
            if [ ! -f "$lock_file" ]; then
                echo "[$(date)] Detected 503 on $domain. Initiating auto-heal..."
                touch "$lock_file"
                
                # Run the clean command in background to not block the log reader
                (
                    "$ISOLATE_CMD" clean "$domain" > "/tmp/wp_isolate_healer_${domain}.log" 2>&1
                    sleep 60
                    rm -f "$lock_file"
                ) &
            fi
        fi
    fi
done
